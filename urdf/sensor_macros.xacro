<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="install_camera"
               params="parent frame optical_frame xyz rpy image_topic info_topic update_rate">
    <link name="${frame}">
      <visual>
        <geometry><box size="0.06 0.04 0.03"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><box size="0.06 0.04 0.03"/></geometry>
      </collision>
      <inertial>
        <mass value="0.10"/>
        <inertia ixx="0.0001" ixy="0" ixz="0"
                 iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
    <joint name="${frame}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${frame}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <link name="${optical_frame}"/>
    <joint name="${optical_frame}_joint" type="fixed">
      <parent link="${frame}"/>
      <child link="${optical_frame}"/>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
    </joint>

    <gazebo reference="${frame}">
      <sensor name="camera_sensor" type="camera">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>${update_rate}</update_rate>
        <camera name="camera_optical">
          <horizontal_fov>1.0472</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20.0</far>
          </clip>
        </camera>
        <plugin name="camera_ros" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/</namespace>
            <remapping>camera/image_raw:=${image_topic}</remapping>
            <remapping>camera/camera_info:=${info_topic}</remapping>
          </ros>
          <camera_name>camera</camera_name>
          <frame_name>${optical_frame}</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="install_lidar"
               params="parent frame xyz rpy topic update_rate">
    <link name="${frame}">
      <visual>
        <geometry><cylinder radius="0.045" length="0.07"/></geometry>
        <material name="gray"/>
      </visual>
      <collision>
        <geometry><cylinder radius="0.045" length="0.07"/></geometry>
      </collision>
      <inertial>
        <mass value="0.25"/>
        <inertia ixx="0.0001" ixy="0" ixz="0"
                 iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
    <joint name="${frame}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${frame}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <gazebo reference="${frame}">
      <sensor name="mid360_lidar" type="ray">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>${update_rate}</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1.0</resolution>
              <min_angle>-3.14159265359</min_angle>
              <max_angle>3.14159265359</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples>
              <resolution>1.0</resolution>
              <min_angle>-0.5235987756</min_angle>
              <max_angle>0.2617993878</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.10</min>
            <max>70.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <plugin name="mid360_pointcloud" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/</namespace>
            <remapping>~/out:=${topic}</remapping>
          </ros>
          <output_type>sensor_msgs/PointCloud2</output_type>
          <frame_name>${frame}</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="install_imu"
               params="parent frame xyz rpy topic update_rate">
    <link name="${frame}">
      <visual>
        <geometry><box size="0.06 0.04 0.02"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><box size="0.06 0.04 0.02"/></geometry>
      </collision>
      <inertial>
        <mass value="0.10"/>
        <inertia ixx="0.0001" ixy="0" ixz="0"
                 iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
    <joint name="${frame}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${frame}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <gazebo reference="${frame}">
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>${update_rate}</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></z>
          </linear_acceleration>
        </imu>
        <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
          <ros>
            <namespace>/</namespace>
            <remapping>~/out:=${topic}</remapping>
          </ros>
          <frame_name>${frame}</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
