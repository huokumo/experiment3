<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="differential_wheel" params="name x y radius width side">
    <link name="${name}_wheel_link">
      <visual name="tire">
        <origin rpy="1.57079632679 0 0"/>
        <geometry><cylinder radius="${radius}" length="${width}"/></geometry>
        <material name="tire_black"/>
      </visual>
      <visual name="outer_hub">
        <origin xyz="0 ${side * (width / 2 + 0.009)} 0" rpy="1.57079632679 0 0"/>
        <geometry><cylinder radius="${radius * 0.48}" length="0.018"/></geometry>
        <material name="hub_silver"/>
      </visual>
      <collision>
        <origin rpy="1.57079632679 0 0"/>
        <geometry><cylinder radius="${radius}" length="${width}"/></geometry>
      </collision>
      <inertial>
        <mass value="2.0"/>
        <inertia ixx="0.018" ixy="0" ixz="0"
                 iyy="0.018" iyz="0" izz="0.018"/>
      </inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="${x} ${y} ${radius}"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="differential_robot_base" params="">
    <xacro:property name="base_length" value="1.10"/>
    <xacro:property name="base_width" value="0.72"/>
    <xacro:property name="base_height" value="0.24"/>
    <xacro:property name="wheel_radius" value="0.18"/>
    <xacro:property name="wheel_width" value="0.12"/>
    <xacro:property name="wheel_separation" value="0.82"/>

    <material name="body_blue"><color rgba="0.04 0.22 0.62 1"/></material>
    <material name="body_dark"><color rgba="0.025 0.055 0.10 1"/></material>
    <material name="deck_gray"><color rgba="0.32 0.38 0.44 1"/></material>
    <material name="tire_black"><color rgba="0.015 0.015 0.02 1"/></material>
    <material name="hub_silver"><color rgba="0.72 0.76 0.80 1"/></material>
    <material name="sensor_black"><color rgba="0.025 0.03 0.035 1"/></material>
    <material name="lens_blue"><color rgba="0.03 0.35 0.68 1"/></material>
    <material name="light_white"><color rgba="1.0 0.92 0.60 1"/></material>
    <material name="light_red"><color rgba="0.75 0.02 0.02 1"/></material>
    <material name="axis_red"><color rgba="0.90 0.05 0.05 1"/></material>

    <link name="base_link">
      <visual name="lower_chassis">
        <origin xyz="0 0 0.27"/>
        <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
        <material name="body_blue"/>
      </visual>
      <visual name="upper_body">
        <origin xyz="-0.06 0 0.43"/>
        <geometry><box size="0.78 0.58 0.12"/></geometry>
        <material name="body_dark"/>
      </visual>
      <visual name="sensor_deck">
        <origin xyz="0.02 0 0.515"/>
        <geometry><box size="0.64 0.48 0.05"/></geometry>
        <material name="deck_gray"/>
      </visual>
      <visual name="front_bumper">
        <origin xyz="0.575 0 0.23"/>
        <geometry><box size="0.05 0.76 0.16"/></geometry>
        <material name="body_dark"/>
      </visual>
      <visual name="rear_bumper">
        <origin xyz="-0.575 0 0.23"/>
        <geometry><box size="0.05 0.76 0.16"/></geometry>
        <material name="body_dark"/>
      </visual>
      <visual name="left_headlight">
        <origin xyz="0.606 0.22 0.30" rpy="0 1.57079632679 0"/>
        <geometry><cylinder radius="0.045" length="0.018"/></geometry>
        <material name="light_white"/>
      </visual>
      <visual name="right_headlight">
        <origin xyz="0.606 -0.22 0.30" rpy="0 1.57079632679 0"/>
        <geometry><cylinder radius="0.045" length="0.018"/></geometry>
        <material name="light_white"/>
      </visual>
      <visual name="left_taillight">
        <origin xyz="-0.606 0.22 0.30" rpy="0 1.57079632679 0"/>
        <geometry><cylinder radius="0.035" length="0.018"/></geometry>
        <material name="light_red"/>
      </visual>
      <visual name="right_taillight">
        <origin xyz="-0.606 -0.22 0.30" rpy="0 1.57079632679 0"/>
        <geometry><cylinder radius="0.035" length="0.018"/></geometry>
        <material name="light_red"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.27"/>
        <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.27"/>
        <mass value="28.0"/>
        <inertia ixx="1.55" ixy="0" ixz="0"
                 iyy="3.05" iyz="0" izz="4.20"/>
      </inertial>
    </link>

    <xacro:differential_wheel
      name="left" x="0.25" y="${wheel_separation / 2}"
      radius="${wheel_radius}" width="${wheel_width}" side="1"/>
    <xacro:differential_wheel
      name="right" x="0.25" y="-${wheel_separation / 2}"
      radius="${wheel_radius}" width="${wheel_width}" side="-1"/>

    <link name="caster_link">
      <visual name="caster_fork">
        <origin xyz="0 0 0.225"/>
        <geometry><cylinder radius="0.075" length="0.19"/></geometry>
        <material name="hub_silver"/>
      </visual>
      <visual name="caster_wheel">
        <origin xyz="0 0 0.13" rpy="1.57079632679 0 0"/>
        <geometry><cylinder radius="0.13" length="0.09"/></geometry>
        <material name="tire_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.13"/>
        <geometry><sphere radius="0.13"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.13"/>
        <mass value="1.2"/>
        <inertia ixx="0.008" ixy="0" ixz="0"
                 iyy="0.008" iyz="0" izz="0.008"/>
      </inertial>
    </link>
    <joint name="caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="caster_link"/>
      <origin xyz="-0.43 0 0"/>
    </joint>

    <gazebo reference="base_link"><material>Gazebo/Blue</material></gazebo>
    <gazebo reference="left_wheel_link"><material>Gazebo/Black</material></gazebo>
    <gazebo reference="right_wheel_link"><material>Gazebo/Black</material></gazebo>
    <gazebo reference="caster_link"><material>Gazebo/Black</material></gazebo>

    <gazebo>
      <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
        <ros><namespace>/</namespace></ros>
        <update_rate>50</update_rate>
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>${wheel_separation}</wheel_separation>
        <wheel_diameter>${2 * wheel_radius}</wheel_diameter>
        <max_wheel_torque>45</max_wheel_torque>
        <max_wheel_acceleration>6</max_wheel_acceleration>
        <command_topic>cmd_vel</command_topic>
        <odometry_topic>odom</odometry_topic>
        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <publish_wheel_tf>false</publish_wheel_tf>
        <publish_wheel_joint_state>true</publish_wheel_joint_state>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
